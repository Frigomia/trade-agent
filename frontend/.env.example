NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public production origin (no trailing slash). Reset-password links redirect here, so it must
# match an exact entry in Supabase's Redirect URLs. Falls back to the browser origin when unset.
NEXT_PUBLIC_SITE_URL=
# Optional Logo.dev CDN publishable key (pk_). Never use the secret API key here. Logos load through
# this app's /api/logo route (signed-in only), so the browser never contacts Logo.dev.
NEXT_PUBLIC_LOGO_DEV_TOKEN=
