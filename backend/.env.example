APP_ENV=development
DATABASE_URL=postgresql+psycopg://trading_agent:trading_agent@localhost:5432/trading_agent
REDIS_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
VOYAGE_API_KEY=
SUPABASE_URL=
MIGRATION_DATABASE_URL=
SUPABASE_SECRET_KEY=
INVITE_REDIRECT_URL=
INVITE_LINK_HOURS=24
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Encrypts users' saved Claude keys. Required in production: openssl rand -base64 32
KEY_ENCRYPTION_SECRET=
# Telegram bot token from BotFather; empty turns the Telegram features off
TELEGRAM_BOT_TOKEN=
# Long random string Telegram sends back as a header on webhook calls
TELEGRAM_WEBHOOK_SECRET=
# Bot username without the @, for the t.me link
TELEGRAM_BOT_USERNAME=
# Frontend origin, for the link to Today in a message
APP_URL=
